// ボタンを押した時のメモリ書き換え
function changeValue(name, addr, type = "I32") {
  let value = Number(prompt(name + "の数値を入力してください"));
  if (!isNaN(value)) {
    h5gg.setValue(addr, value, type);
    if (type === "I32") {
      h5gg.setValue(addr + 4, 0, "I32");
    } else if (type === "I16") {
      h5gg.setValue(addr + 2, 0, "I16");
    }
    alert(name + "を変更しました");
  } else {
    alert("有効な数値を入力してください");
  }
}
