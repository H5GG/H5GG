 function showTab(tabName) {

    document.getElementById("base").classList.remove("active-content");
    document.getElementById("matatabi").classList.remove("active-content");
    document.getElementById("other").classList.remove("active-content");

    document.getElementById("tab1").classList.remove("active-tab");
    document.getElementById("tab2").classList.remove("active-tab");
    document.getElementById("tab3").classList.remove("active-tab");

    document.getElementById(tabName).classList.add("active-content");

