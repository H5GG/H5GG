function changeBasicAll() {
  h5gg.setValue(nekokan, 58999, "I32");
  h5gg.setValue(xp, 999999999, "I32");
  h5gg.setValue(np, 99999, "I32");
  let list = [nekokan, xp, np];
  for (let addr of list) {
    h5gg.setValue(addr + 4, 0, "I32");
    h5gg.setValue(addr - 4, 0, "I32");
  }
  alert("基本リソースをまとめて変更しました！");
}
function unlockKyara1() {
  let baseAddr = kyara1;
  let nekoValue = Number(h5gg.getValue(baseAddr, "I32"));
  const skipList = [
    0x26c, 0x2d8, 0x474, 0x500, 0x54c, 0x584,
    0x6c0, 0x6c4, 0x744, 0x7c4, 0x7c8, 0x7cc,
    0x7d0, 0x7b0, 0xa84,
    0xb90, 0xb94, 0xb98, 0xb9c, 0xba0, 0xba4,
    0xc50, 0xca8
  ];
  for (let i = 0; i < 860; i++) {
    let offset = i * 4;
    if (skipList.includes(offset)) continue; 
    let addr = baseAddr + offset;
    h5gg.setValue(addr, nekoValue, "I32");
  }
  alert("全キャラを解放しました");
}

function unlockKyara2() {
  let baseAddr = kyara2;
  let hexAddr = baseAddr.toString(16).toLowerCase();
  let targetGroup = [];
  if (hexAddr.endsWith("0") || hexAddr.endsWith("8")) targetGroup = ["0","8"];
  else if (hexAddr.endsWith("4") || hexAddr.endsWith("c")) targetGroup = ["4","c"];
  else { alert("対象外です"); return; }
  let count=0;
  for (let offset=0; count<860; offset++) {
    let addr = baseAddr+(offset*4);
    let hex = addr.toString(16).toLowerCase();
    if (targetGroup.some(s=>hex.endsWith(s))) {
      h5gg.setValue(addr,150,"I32");
      count++;
    }
  }
